-            if delta > 0.0 {
-                Ordering::Greater
-            } else if delta < 0.0 {
-                Ordering::Less
-            } else {
-                Ordering::Equal
-            }
-        });
-        seen.dedup_by(|a, b| RefreshRate(a.refresh_rate) == b.refresh_rate);
