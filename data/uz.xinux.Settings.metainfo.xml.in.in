<?xml version="1.0" encoding="UTF-8"?>
<!-- Baxrom Raxmatov 2026 <magdiyevbahrom@gmail.com> -->
<component type="desktop-application">
  <id>@app-id@</id>
  <metadata_license>CC0</metadata_license>
  <project_license>GPL-2.0</project_license>
  <name>Xinux Settings</name>
  <summary>Settings app compatible with NixOS</summary>
  <description>
    <p>Xinux GTK/libadwaita settings app</p>
  </description>
  <screenshots>
    <screenshot type="default">
      <image>https://github.com/xinux-org/settings/blob/main/.github/assets/demo-image.png</image>
      <caption>Main window</caption>
    </screenshot>
  </screenshots>
  <url type="homepage">https://github.com/xinux-org/settings</url>
  <url type="bugtracker">https://github.com/xinux-org/settings/issues</url>
  <!-- Source code repository -->
  <url type="vcs-browser">https://github.com/xinux-org/settings</url>
  <!-- Translation repository -->
  <url type="translate">https://github.com/xinux-org/settings/tree/main/po</url>
  <releases>
    <release version="0.1.0" date="2026-05-08" />
  </releases>
  <developer_name translate="yes">bemeritus</developer_name>
  <developer_name translate="yes">ae5259</developer_name>
  <developer_name translate="yes">bahrom04</developer_name>
  <developer_name translate="yes">rafanochi</developer_name>
  <developer_name translate="yes">Xinux Developers</developer_name>
  <!--
    Branding colors:
    https://docs.flathub.org/docs/for-app-authors/metainfo-guidelines/#brand-color
  -->
  <branding>
    <color type="primary" scheme_preference="light">#ff00ff</color>
    <color type="primary" scheme_preference="dark">#993d3d</color>
  </branding>
  <update_contact>support@oss.uzinfocom.uz</update_contact>
  <translation type="gettext">@gettext-package@</translation>
  <launchable type="desktop-id">@app-id@.desktop</launchable>
</component>
